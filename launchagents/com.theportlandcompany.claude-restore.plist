<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theportlandcompany.claude-restore</string>
  <!-- At login this OFFERS the picker; it never restores on its own. A mass login
       restore rewrites every session's prefix cold (~$6 per 300k-token session),
       so the choice of which sessions come back stays with the human. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.claude/scripts/claude-session-offer.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.claude/logs/session-restore.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/logs/session-restore.log</string>
</dict>
</plist>
